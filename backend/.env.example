# ---------------------------------------------------------------------------
# NEXA backend configuration.  Copy to .env.  NEVER commit .env or real keys.
# ---------------------------------------------------------------------------

# Which AI provider plans adaptive steps.
#   auto                          -> AUTO_PROVIDER_ORDER below (default: groq, gemini, ollama, openai, claude)
#   groq|gemini|ollama|openai|claude|grok -> that provider only (the UI can also choose per task)
# A manually chosen provider that is not configured is rejected with a clear error - it never silently
# falls back to a different (possibly paid) one.
AI_PROVIDER=auto
# Order tried by AUTO. A hosted provider is used by AUTO only if it is listed here AND enabled below
# AND has a key. Pricing/quotas differ per provider and change over time - check your own plan.
AUTO_PROVIDER_ORDER=groq,gemini,ollama,openai,claude
GROQ_ENABLED=true
GEMINI_ENABLED=true
OLLAMA_ENABLED=true

# ---- Groq (groq.com - NOT Grok/xAI; first in the AUTO order) ---------------------
# Free-tier limits change: check console.groq.com. Rate limits / quota are handled with bounded fallback + cooldown.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# 0 = use HOSTED_PROVIDER_TIMEOUT_SECONDS
GROQ_TIMEOUT_SECONDS=0

# ---- Gemini ------------------------------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash returns 404 "no longer available to new users" for new keys; the API
# recommended gemini-3.8-flash. NEXA could not verify that name offline - confirm it for your key.
# Used exactly as written - NEXA does not rewrite or assume model availability.
# Set this to a model your API key can actually access (check Google AI Studio /
# the ListModels API). If the API rejects the name, the failure is reported in
# the task's PROVIDER_STATUS events.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CALL_TIMEOUT_SECONDS=15
GEMINI_COOLDOWN_SECONDS=300
GEMINI_TIMEOUT_COOLDOWN_SECONDS=60
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# ---- Ollama (emergency fallback only) ---------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=30
# Hard per-TASK emergency budget. Every request, including a JSON repair
# request, counts. When exhausted Ollama is retired for the task and NEXA falls
# back to generic live-DOM recovery.
OLLAMA_EMERGENCY_MAX_CALLS_PER_TASK=2
OLLAMA_EMERGENCY_TIMEOUT_SECONDS=20
OLLAMA_EMERGENCY_BUDGET_SECONDS=30
OLLAMA_COOLDOWN_SECONDS=120

# ---- Hosted providers (OPTIONAL, individually enabled, placeholders only) ----------
# Keys belong ONLY in backend/.env (git-ignored). They are never sent to the frontend, logs, events or history.
# There is deliberately no default model: model names change, set one your key can use.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

CLAUDE_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Grok (xAI, OpenAI-compatible API)
XAI_ENABLED=false
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1

# Limits that apply to every hosted provider
HOSTED_PROVIDER_MAX_CALLS_PER_TASK=12
HOSTED_PROVIDER_TIMEOUT_SECONDS=20
HOSTED_PROVIDER_MAX_OUTPUT_TOKENS=1500
HOSTED_PROVIDER_COOLDOWN_SECONDS=300

# One bounded AI call to interpret an unclear request (never used to weaken a safety confirmation).
AI_UNDERSTANDING_ENABLED=true

# ---- Browser execution -------------------------------------------------------
# Only "local" (your own Chrome over CDP) is implemented. Browser Use Cloud is NOT implemented in this
# build; any other value is reported by /api/providers and ignored (local is used).
BROWSER_EXECUTION_MODE=local
BROWSER_USE_API_KEY=

# ---- Task deadline & budgets ----------------------------------------------
# Outer hard timeout. The agent's INTERNAL deadline is this minus the margin,
# so it can stop gracefully with a diagnostic instead of being cancelled.
TASK_TIMEOUT_SECONDS=360
TASK_DEADLINE_MARGIN_SECONDS=8
# Share of the deadline AI planning may use (the rest is browser work).
AI_PLANNING_BUDGET_FRACTION=0.35
RECOVERY_BUDGET_FRACTION=0.15
# Time always kept free for browser actions + final verification.
BROWSER_RESERVE_SECONDS=20

# ---- Loop protection --------------------------------------------------------
MAX_FALSE_DONE_CLAIMS=3
NO_PROGRESS_RECOVER_AFTER=3
NO_PROGRESS_FAIL_AFTER=6

# ---- Browser ----------------------------------------------------------------
BROWSER_HEADLESS=false
BROWSER_PREFER_SYSTEM_CHROME=true
BROWSER_ACTION_TIMEOUT_MS=7000
BROWSER_NAV_TIMEOUT_MS=25000
BROWSER_MAX_RETRIES=2
# Set true only for intentional local/private-network tasks (e.g. test fixtures).
ALLOW_PRIVATE_NETWORK=false

# ---- Network ------------------------------------------------------------------
# The backend binds to localhost only. Do not change HOST to 0.0.0.0 unless you add your own network protection.
HOST=127.0.0.1
PORT=8000
# Browser origins allowed to call the API (comma separated). Local dev only by default.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Supabase (OPTIONAL: sign-in + saved history; off = local single-user mode) --------------
# Supabase only stores WHO the user is and WHAT the backend decided. It never plans actions or decides success.
SUPABASE_ENABLED=false
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key: safe for the browser, access is limited by Row Level Security.
SUPABASE_PUBLISHABLE_KEY=
# BACKEND ONLY, OPTIONAL. Never put this in the frontend or commit it. Used only to finish a background
# history write after the user's token expired; reads never use it. Leave empty to disable that fallback.
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=8
SUPABASE_TOKEN_CACHE_SECONDS=30
